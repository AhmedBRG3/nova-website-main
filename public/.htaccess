# NOVA on GoDaddy cPanel (Apache).
# Every non-file URL goes through seo.php, which serves index.html with that
# page's own <title>, description, canonical, social tags and JSON-LD filled in
# from /content/*.json — so edits made in /admin are live instantly.
DirectoryIndex seo.php index.html
Options -Indexes

RewriteEngine On

# Force HTTPS (remove these 3 lines if your SSL certificate isn't active yet).
# localhost is exempt so `npm run preview:apache` works over plain http.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
# Only redirect when the *browser* asked for these files. Without the
# THE_REQUEST check this rule re-fires on mod_dir's internal "/" -> seo.php
# lookup and loops forever on the home page.
RewriteCond %{THE_REQUEST} \s/+(index\.html|seo\.php)[\s?]
RewriteRule ^ / [L,R=301]

# One URL per page: /work/x/ -> /work/x
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ seo.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "^seo\.php$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
